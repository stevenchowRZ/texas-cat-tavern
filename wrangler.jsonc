{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "texas-cat-tavern",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POKER_ROOMS",
        "class_name": "PokerRoom"
      }
    ]
  },
  "exports": {
    "PokerRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
